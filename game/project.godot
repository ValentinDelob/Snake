; Snake 3D - Godot project
;
; Converted from the original pygame implementation (kept in legacy/python).

config_version=5

[application]

config/name="Snake 3D"
config/description="Snake rendered in 3D, converted from a pygame prototype."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Journal="*res://scripts/journal.gd"
PlayerProfile="*res://scripts/profile_store.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/snake.log"
file_logging/max_log_files=5

[display]

window/size/viewport_width=1024
window/size/viewport_height=640

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
